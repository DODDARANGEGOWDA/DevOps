{
	"name": "df_Agg_Trans",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_empdept_source",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Eid as integer,",
				"          Ename as string,",
				"          Enum as integer,",
				"          Email as string,",
				"          EmAnager as string,",
				"          Esal as integer,",
				"          DOJ as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     partitionBy('hash', 1)) ~> source1",
				"source1 derive(AddDays = addDays(toDate(DOJ,'dd/MM/yyyy','en-US'),12)) ~> derivedColumn1"
			]
		}
	}
}