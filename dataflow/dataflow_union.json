{
	"name": "dataflow_union",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedText6",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DelimitedText7",
						"type": "DatasetReference"
					},
					"name": "sink1"
				},
				{
					"dataset": {
						"referenceName": "DelimitedText7",
						"type": "DatasetReference"
					},
					"name": "sink2"
				}
			],
			"transformations": [
				{
					"name": "aggregate1"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Empid as integer,",
				"          Ename as string,",
				"          Enum as integer,",
				"          Email as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 aggregate(groupBy(Empid,",
				"          Ename,",
				"          Enum),",
				"     Counts = count(Empid)) ~> aggregate1",
				"aggregate1 split(Counts>1,",
				"     disjoint: false,",
				"     partitionBy('hash', 1)) ~> split1@(DupicateRecords, ValidRecords)",
				"split1@DupicateRecords sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Empid as string,",
				"          Ename as string,",
				"          Enum as string,",
				"          Email as string",
				"     ),",
				"     partitionFileNames:['Dupicates.csv'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1",
				"split1@ValidRecords sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Empid as string,",
				"          Ename as string,",
				"          Enum as string,",
				"          Email as string",
				"     ),",
				"     partitionFileNames:['ValidRecords.csv'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink2"
			]
		}
	}
}