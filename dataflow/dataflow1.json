{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedText1",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "DelimitedText2",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DelimitedText4",
						"type": "DatasetReference"
					},
					"name": "sink1",
					"rejectedDataLinkedService": {
						"referenceName": "AzureDataLakeStorage1",
						"type": "LinkedServiceReference"
					}
				},
				{
					"dataset": {
						"referenceName": "DelimitedText4",
						"type": "DatasetReference"
					},
					"name": "sink2",
					"rejectedDataLinkedService": {
						"referenceName": "AzureDataLakeStorage1",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "select1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "filter2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Index as string,",
				"          User_Id as string,",
				"          First_Name as string,",
				"          Last_Name as string,",
				"          Sex as string,",
				"          Email as string,",
				"          Date_of_birth as string,",
				"          Job_Title as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source(output(",
				"          Index as string,",
				"          User_Id as string,",
				"          First_Name as string,",
				"          Last_Name as string,",
				"          Sex as string,",
				"          Email as string,",
				"          Date_of_birth as string,",
				"          Job_Title as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source2",
				"source1, source2 join(source1@Index == source2@Index,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          Index = source1@Index,",
				"          User_Id = source1@User_Id,",
				"          First_Name = source1@First_Name,",
				"          Last_Name = source1@Last_Name,",
				"          Sex = source1@Sex,",
				"          Email = source1@Email,",
				"          Date_of_birth = source1@Date_of_birth,",
				"          Job_Title = source1@Job_Title,",
				"          Index = source2@Index,",
				"          User_Id = source2@User_Id,",
				"          First_Name = source2@First_Name,",
				"          Last_Name = source2@Last_Name,",
				"          Sex = source2@Sex,",
				"          Email = source2@Email,",
				"          Date_of_birth = source2@Date_of_birth,",
				"          Job_Title = source2@Job_Title",
				"     ),",
				"     partitionBy('hash', 1),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 filter(substring(First_Name,1,2) =='Sh',",
				"     partitionBy('hash', 1)) ~> filter1",
				"select1 filter(substring(First_Name,1,1) =='K') ~> filter2",
				"filter2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     filePattern:'KnAMNE.csv',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     filePattern:'SName.csv',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink2"
			]
		}
	}
}