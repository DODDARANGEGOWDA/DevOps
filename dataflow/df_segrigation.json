{
	"name": "df_segrigation",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"name": "source1"
				}
			],
			"sinks": [
				{
					"name": "sink1"
				},
				{
					"name": "sink2"
				}
			],
			"transformations": [
				{
					"name": "aggregate1"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Empid as integer,",
				"          Ename as string,",
				"          Enum as integer,",
				"          Email as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false) ~> source1",
				"source1 aggregate(groupBy(Empid,",
				"          Ename),",
				"     Agrigate = count(Empid),",
				"     partitionBy('hash', 1)) ~> aggregate1",
				"aggregate1 split(Agrigate==1,",
				"     disjoint: false,",
				"     partitionBy('hash', 1)) ~> split1@(ValiedRecarods, UnvaliedRecarods)",
				"split1@ValiedRecarods sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['valied.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1),",
				"     preCommands: [],",
				"     postCommands: []) ~> sink1",
				"split1@UnvaliedRecarods sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['dupilcate.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1),",
				"     preCommands: [],",
				"     postCommands: []) ~> sink2"
			]
		}
	}
}