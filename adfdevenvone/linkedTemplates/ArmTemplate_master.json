{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfdevenvone"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
		},
		"Get_metaLinked_Services_Sources_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'Get_metaLinked_Services_Sources'"
		},
		"connectinghost services_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'connectinghost services'"
		},
		"isSqlServer1dynamic_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'isSqlServer1dynamic'",
			"defaultValue": "integrated security=True;Data Source=Z1-471\\SQLEXPRESS;Initial Catalog=@{linkedService().daname}"
		},
		"isSqlServer1dynamic_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'isSqlServer1dynamic'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storageaccountnametwo.dfs.core.windows.net/"
		},
		"Get_metaLinked_Services_Sources_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storageaccountnametwo.dfs.core.windows.net/"
		},
		"isSqlServer1dynamic_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Z1-471\\acer"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfdevenvone_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorage1_accountKey": {
						"value": "[parameters('AzureDataLakeStorage1_accountKey')]"
					},
					"Get_metaLinked_Services_Sources_accountKey": {
						"value": "[parameters('Get_metaLinked_Services_Sources_accountKey')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"Get_metaLinked_Services_Sources_properties_typeProperties_url": {
						"value": "[parameters('Get_metaLinked_Services_Sources_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adfdevenvone_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"connectinghost services_connectionString": {
						"value": "[parameters('connectinghost services_connectionString')]"
					},
					"isSqlServer1dynamic_connectionString": {
						"value": "[parameters('isSqlServer1dynamic_connectionString')]"
					},
					"isSqlServer1dynamic_password": {
						"value": "[parameters('isSqlServer1dynamic_password')]"
					},
					"isSqlServer1dynamic_properties_typeProperties_userName": {
						"value": "[parameters('isSqlServer1dynamic_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adfdevenvone_ArmTemplate_0')]"
			]
		}
	]
}