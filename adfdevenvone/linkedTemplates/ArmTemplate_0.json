		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfdevenvone"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
		},
		"Get_metaLinked_Services_Sources_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'Get_metaLinked_Services_Sources'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storageaccountnametwo.dfs.core.windows.net/"
		},
		"Get_metaLinked_Services_Sources_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storageaccountnametwo.dfs.core.windows.net/"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
